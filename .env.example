# Copy to .env and adjust as needed.
# When unset, requests go to /api (proxied by Vite to localhost:3000).
# VITE_API_BASE_URL=https://api.example.com

# Optional: prefill the login form in dev mode only (never used in production builds).
# VITE_DEV_LOGIN_EMAIL=you@example.com
# VITE_DEV_LOGIN_PASSWORD=your-dev-password
